{
  "name": "unmute-cloud-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Closed-source desktop build of unmute with managed-cloud paywall, wrapping the OSS unmute-dictation engine.",
  "scripts": {
    "build": "./build/wire-into-engine.sh build",
    "build:fast": "./build/wire-into-engine.sh build --no-sign",
    "dev": "./build/wire-into-engine.sh dev",
    "engine:sync": "./build/wire-into-engine.sh sync",
    "test": "node --import tsx --import ./electron/remote/test-setup.ts --test 'electron/remote/**/*.test.ts' 'engine-overrides/renderer/widget/**/*.test.ts' 'engine-overrides/electron/**/*.test.ts' 'engine-overrides/renderer/remote/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.2.0",
    "node-pty": "^1.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
